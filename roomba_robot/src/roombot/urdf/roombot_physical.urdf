<robot name="roomba_bot">
  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.1651" length="0.0762"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!-- render as a disk -->
      <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1651" length="0.0762"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <!-- tiny inertial to keep tools happy -->
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Wheel links -->
  <link name="left_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.0331" length="0.026"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0331" length="0.026"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.0331" length="0.026"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0331" length="0.026"/>
      </geometry>
    </collision>
  </link>

  <!-- Front CASTER (passive) -->
  <link name="caster_link">
    <visual>
      <geometry><cylinder radius="0.025" length="0.02"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.025" length="0.02"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  

  <!-- Wheel joints -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.1143 -0.02" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.1143 -0.02" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- Front CASTER (passive) -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="0.127 0.000 -0.03" rpy="1.57 0 0"/>
  </joint>

  <!-- LiDAR link -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.08255 0.00635 0.0889" rpy="0 0 0"/>
  </joint>

  <!-- IMU link -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.056 0.075 0.05" rpy="0 0 0"/>
  </joint>
</robot>